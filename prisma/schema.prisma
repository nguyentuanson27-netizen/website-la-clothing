generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncEventStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ProductMirror {
  id               String          @id @default(cuid())
  pancakeProductId String          @unique
  slug             String          @unique
  name             String
  isActive         Boolean         @default(true)
  syncedAt         DateTime
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  variants         VariantMirror[]
}

model VariantMirror {
  id                 String           @id @default(cuid())
  pancakeVariationId String           @unique
  productId          String
  sku                String?
  color              String?
  size               String?
  isActive           Boolean          @default(true)
  syncedAt           DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  product            ProductMirror    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseStocks    WarehouseStock[]

  @@index([productId])
  @@index([sku])
}

model WarehouseStock {
  id                 String        @id @default(cuid())
  variantId          String
  pancakeWarehouseId String
  quantity           Int
  syncedAt           DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  variant             VariantMirror @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, pancakeWarehouseId])
  @@index([pancakeWarehouseId])
}

model SyncEvent {
  id         String          @id @default(cuid())
  kind       String
  externalId String?
  status     SyncEventStatus @default(PENDING)
  errorCode  String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([kind, status])
  @@index([externalId])
}
