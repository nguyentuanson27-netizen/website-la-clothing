# Copy to deploy/vps/.env.production on the VPS and chmod 600.
# Never commit the real file.

# Exact approved application commit to build/promote.
RELEASE_SHA=replace-with-approved-git-sha

# Public origin. Keep Cloudflare DNS-only during initial launch.
APP_DOMAIN=shop.example.com
BETTER_AUTH_URL=https://shop.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_IP_HEADER=x-la-client-ip

# Database container inputs. DATABASE_URL must use host `postgres` on the Compose network.
POSTGRES_DB=la_clothing
POSTGRES_USER=la_clothing
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://la_clothing:URL_ENCODED_PASSWORD@postgres:5432/la_clothing

# Third-party integration.
PANCAKE_API_KEY=replace-me
PANCAKE_SHOP_ID=replace-me

# Server-owned shipping policy.
LA_SHIPPING_FEE_VND=30000
LA_FREE_SHIPPING_SUBTOTAL_VND=1000000
LA_FREE_SHIPPING_MIN_QUANTITY=3

# Record/pin reviewed image references before go-live. Digests are preferred on the real VPS.
POSTGRES_IMAGE=postgres:16-bookworm
CADDY_IMAGE=caddy:2-alpine
