{
  "name": "website-la-clothing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types --test tests/domain/*.test.ts",
    "test": "node --experimental-strip-types --test tests/domain/*.test.ts tests/integrations/*.test.ts",
    "test:db": "node --experimental-strip-types --test tests/database/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "pancake:contract:discover": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-contract-discover.ts",
    "pancake:contract:verify": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-contract-shape.ts",
    "pancake:stock:probe": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/pancake-stock-probe.ts",
    "pancake:order:inspect-openapi": "node --experimental-strip-types scripts/pancake-order-openapi-inspect.ts",
    "pancake:order-status:inspect-openapi": "node --experimental-strip-types scripts/pancake-order-status-openapi-inspect.ts",
    "pancake:geo:inspect-openapi": "node --experimental-strip-types scripts/pancake-geo-openapi-inspect.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.25",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.6.25",
    "dotenv": "17.4.2",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
