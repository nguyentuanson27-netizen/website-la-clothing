# Server-only secrets. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/la_clothing"

# Server-owned storefront origin host. Public deployments use HTTPS automatically;
# localhost/127.0.0.1 may use an explicit port for local HTTP development.
APP_DOMAIN="localhost:3000"

# Search exposure is fail-closed. Keep false on local/staging and until the
# dedicated LA Clothing production domain passes the explicit launch gate.
SEARCH_INDEXING_ENABLED="false"

# Better Auth: generate a high-entropy secret with at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Required for non-local deployments. Set this only to a single-value client-IP
# header that your edge/proxy overwrites and end users cannot spoof directly.
# Example for a suitably configured proxy/CDN: cf-connecting-ip, x-vercel-forwarded-for, etc.
# BETTER_AUTH_IP_HEADER="replace-with-your-trusted-client-ip-header"

PANCAKE_API_KEY="replace-me"
PANCAKE_SHOP_ID="replace-me"

# Server-owned shipping policy. Omit these to use the approved defaults:
# 30,000 VND shipping; free over 1,000,000 VND merchandise subtotal or from 3 items.
# Values must be canonical non-negative base-10 integers; minimum quantity must be >= 1.
# LA_SHIPPING_FEE_VND="30000"
# LA_FREE_SHIPPING_SUBTOTAL_VND="1000000"
# LA_FREE_SHIPPING_MIN_QUANTITY="3"
